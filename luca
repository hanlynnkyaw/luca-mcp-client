#!/usr/bin/env bash
# Start Claude Code for one client:  ./luca <client> [claude options]
# Loads clients/<client>.env into the environment so .mcp.json's ${LUCA_TOKEN}
# is that client's token, then launches Claude Code in this folder.
set -euo pipefail
cd "$(dirname "$0")"

list_clients() {
    local found=0 f
    for f in clients/*.env; do
        [ -e "$f" ] || continue
        f="${f#clients/}"; f="${f%.env}"
        [ "$f" = "example" ] && continue
        echo "  $f"; found=1
    done
    [ "$found" = 1 ] || echo "  (none yet - copy clients/example.env to clients/<client>.env)"
}

# Read KEY=VALUE lines and export them. The file is parsed, not sourced: Luca
# tokens contain "|", which a sourced shell file would read as a pipe.
load_env_file() {
    local line key value
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|[[:space:]]*'#'*|'#'*) continue ;; esac
        case "$line" in *=*) ;; *) continue ;; esac
        key="${line%%=*}"; value="${line#*=}"
        key="${key//[[:space:]]/}"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        case "$value" in
            \"*\") value="${value#\"}"; value="${value%\"}" ;;
            \'*\') value="${value#\'}"; value="${value%\'}" ;;
        esac
        export "$key=$value"
    done < "$1"
}

if [ $# -lt 1 ] || [ "$1" = "example" ]; then
    echo "Usage: ./luca <client> [claude options]"
    echo "Clients with a token file:"
    list_clients
    exit 1
fi

client="$1"; shift
file="clients/$client.env"

if [ ! -f "$file" ]; then
    echo "No token file for '$client'."
    echo "Copy clients/example.env to $file and paste that client's token in."
    exit 1
fi

load_env_file "$file"
export LUCA_MCP_URL="${LUCA_MCP_URL:-https://api.luca.pro/mcp}"

if [ -z "${LUCA_TOKEN:-}" ] || [ "$LUCA_TOKEN" = "paste-the-token-here" ]; then
    echo "$file has no token yet. Paste the token from Luca (Settings -> API Tokens) into it."
    exit 1
fi

echo "Luca client: $client"
exec claude "$@"
