# One file per client. Copy this to clients/<client>.env, for example clients/acme.env,
# and paste in the token you made while that client's company was selected in Luca
# (Settings -> API Tokens). Then start with:  ./luca acme
# Paste it exactly as Luca shows it, straight after the = sign. No quotes needed.
LUCA_TOKEN=paste-the-token-here

# Only for testing against a Luca on your own machine:
# LUCA_MCP_URL=http://127.0.0.1:8000/mcp
